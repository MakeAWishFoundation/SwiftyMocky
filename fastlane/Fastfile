fastlane_version "2.51.0"

default_platform :ios

platform :ios do
    desc "Runs all the tests"
    lane :test do
        # No device is pinned on purpose: a hardcoded model is what rots first, and the runner
        # image only ever carries the simulators of its own Xcode.
        scan(
            scheme: "Mocky_Tests_iOS",
            workspace: "./SwiftyMocky.xcworkspace"
        )
    end
end

platform :tvos do
    desc "Runs all the tests"
    lane :test do
        scan(
            scheme: "Mocky_Tests_tvOS",
            workspace: "./SwiftyMocky.xcworkspace"
        )
    end
end

platform :mac do
    desc "Runs all the tests"
    lane :test do
        scan(scheme: "Mocky_Tests_macOS")
    end
end
